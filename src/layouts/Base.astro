---
import '../styles/global.css'
import { site, nav } from '../site'
import Logo from '../components/Logo.astro'
import Icon from '../components/Icon.astro'

interface Props {
  title?: string
  description?: string
  wide?: boolean
}
const { title, description = site.description, wide = false } = Astro.props

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const path = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#c8a288" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    <!-- Set before first paint: the reveal/diagram CSS only hides things when
         scripting is available to un-hide them again. -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="menubar" id="nav">
      <div class="menubar__inner">
        <a class="brand" href="/" aria-label="Jasper — home">
          <span class="brand__tile"><Logo class="brand__mark" /></span>
          <span class="brand__name">Jasper</span>
        </a>

        <nav class="menu" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={['menu__item', { 'is-active': item.href === '/docs' && path.startsWith('/docs') }]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="menubar__end">
          <a class="btn btn--ghost btn--sm menubar__gh" href={site.repo} target="_blank" rel="noopener">
            <Icon name="github" size={14} /> GitHub
          </a>
          <button class="iconbtn" id="nav-toggle" type="button" aria-label="Menu" aria-expanded="false">
            <Icon name="menu" />
          </button>
        </div>
      </div>

      <div class="drawer" id="nav-drawer" hidden>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={site.repo} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </header>

    <main id="main" class:list={{ 'is-wide': wide }}>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="win win--lg foot__win">
          <div class="win__bar">
            <span class="win__title">jasper — about</span>
            <span class="win__ctl" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>

          <div class="foot__body">
            <div class="foot__brand">
              <a class="brand" href="/">
                <span class="brand__tile"><Logo class="brand__mark" /></span>
                <span class="brand__name">Jasper</span>
              </a>
              <p>
                {site.tagline}<br />A single static Go binary.<br />One dependency.
              </p>
              <span class="foot__status"><i></i> v1 — early, and honest about it</span>
            </div>

            <div class="foot__cols">
              <div>
                <h3>Documentation</h3>
                <a href="/docs/architecture">Architecture</a>
                <a href="/docs/workflows">Workflows</a>
                <a href="/docs/checks">Check reference</a>
                <a href="/docs/languages">Languages</a>
              </div>
              <div>
                <h3>Integrate</h3>
                <a href="/docs/mcp">MCP setup</a>
                <a href="/docs/scaling">Scaling</a>
                <a href="/docs/contributing">Contributing</a>
              </div>
              <div>
                <h3>Project</h3>
                <a href={site.repo} target="_blank" rel="noopener">Source ↗</a>
                <a href={site.issues} target="_blank" rel="noopener">Issues ↗</a>
                <a href={site.author.url} target="_blank" rel="noopener">{site.author.name} ↗</a>
              </div>
            </div>
          </div>

          <div class="foot__status-bar">
            <span>© {new Date().getFullYear()} {site.author.name}</span>
            <span class="foot__grip" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // --- mobile drawer ----------------------------------------------------
      const burger = document.getElementById('nav-toggle')
      const drawer = document.getElementById('nav-drawer')
      burger?.addEventListener('click', () => {
        const open = drawer.hasAttribute('hidden')
        drawer.toggleAttribute('hidden', !open)
        burger.setAttribute('aria-expanded', String(open))
      })
      drawer?.addEventListener('click', (e) => {
        if (e.target.tagName === 'A') {
          drawer.setAttribute('hidden', '')
          burger.setAttribute('aria-expanded', 'false')
        }
      })

      // --- reveal + diagram playback ---------------------------------------
      // Diagrams stay paused until they are on screen, so a reader always sees
      // an animation from frame one rather than halfway through.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.classList.add('is-in')
            io.unobserve(entry.target)
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
      )
      document.querySelectorAll('[data-reveal], [data-anim]').forEach((el) => io.observe(el))

      // --- copy buttons -----------------------------------------------------
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-copy]')
        if (!btn) return
        try {
          await navigator.clipboard.writeText(btn.dataset.copy)
          btn.classList.add('is-copied')
          setTimeout(() => btn.classList.remove('is-copied'), 1600)
        } catch {}
      })
    </script>

    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--title);
        color: var(--title-ink);
        padding: 0.7rem 1.1rem;
        border: var(--edge) solid var(--ink);
        z-index: 200;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .skip:focus {
        left: 0;
      }

      /* --- menu bar ------------------------------------------------------- */
      .menubar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--win);
        border-bottom: var(--edge) solid var(--ink);
      }

      .menubar__inner {
        max-width: var(--page);
        margin-inline: auto;
        padding: 0.5rem var(--gutter);
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        flex: none;
      }
      /* The mark lives on a white tile with a hard outline — on the peach window
         surface its mid-tones would otherwise disappear. */
      .brand__tile {
        display: grid;
        place-items: center;
        width: 2.1rem;
        height: 2.1rem;
        background: var(--field);
        border: var(--edge) solid var(--ink);
        border-radius: var(--radius-sm);
        box-shadow: var(--drop-sm);
        transition: transform 0.1s linear, box-shadow 0.1s linear;
      }
      .brand:hover .brand__tile {
        transform: translate(2px, 2px);
        box-shadow: 0 0 0 var(--ink);
      }
      .brand__mark {
        height: 1.15rem;
      }
      .brand__name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
      }

      .menu {
        display: flex;
        gap: 0.15rem;
        margin-left: auto;
      }
      .menu__item {
        padding: 0.35rem 0.7rem;
        border: var(--edge) solid transparent;
        border-radius: var(--radius-sm);
        font-size: 0.82rem;
        color: var(--ink-soft);
        transition: none;
      }
      .menu__item:hover,
      .menu__item.is-active {
        background: var(--title);
        color: var(--title-ink);
        border-color: var(--ink);
      }

      .menubar__end {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: none;
      }
      .btn--sm {
        padding: 0.4rem 0.75rem;
        font-size: 0.75rem;
      }

      .iconbtn {
        display: none;
        place-items: center;
        width: 2.1rem;
        height: 2.1rem;
        background: var(--win-2);
        border: var(--edge) solid var(--ink);
        border-radius: var(--radius-sm);
        box-shadow: var(--drop-sm);
      }
      .iconbtn:active {
        transform: translate(3px, 3px);
        box-shadow: none;
      }

      .drawer {
        display: none;
        flex-direction: column;
        padding: 0.5rem var(--gutter) 0.85rem;
        border-top: var(--edge) solid var(--ink);
        background: var(--win-2);
      }
      .drawer a {
        padding: 0.6rem 0.6rem;
        font-size: 0.9rem;
        border: var(--edge) solid transparent;
        border-radius: var(--radius-sm);
      }
      .drawer a:hover {
        background: var(--title);
        color: var(--title-ink);
        border-color: var(--ink);
      }

      @media (max-width: 900px) {
        .menu,
        .menubar__gh {
          display: none;
        }
        .iconbtn {
          display: grid;
        }
        .menubar__end {
          margin-left: auto;
        }
        .drawer:not([hidden]) {
          display: flex;
        }
      }

      /* --- footer --------------------------------------------------------- */
      .foot {
        padding-block: clamp(2.5rem, 6vw, 4.5rem);
      }
      .foot__win {
        overflow: hidden;
      }
      .foot__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr);
        gap: clamp(1.75rem, 4vw, 3.5rem);
        padding: clamp(1.4rem, 3vw, 2.25rem);
      }
      .foot__brand p {
        margin-top: 1rem;
        color: var(--ink-soft);
        font-size: 0.82rem;
        line-height: 1.8;
      }
      .foot__status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        font-size: 0.75rem;
        color: var(--ink-soft);
      }
      .foot__status i {
        width: 9px;
        height: 9px;
        background: var(--green);
        border: 1.5px solid var(--ink);
        animation: blink-led 2.2s steps(1, end) infinite;
      }
      @keyframes blink-led {
        50% {
          background: var(--win-2);
        }
      }

      .foot__cols {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.75rem;
      }
      .foot__cols h3 {
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 0.85rem;
        padding-bottom: 0.5rem;
        border-bottom: var(--edge) solid var(--ink);
      }
      .foot__cols a {
        display: block;
        padding: 0.28rem 0;
        font-size: 0.82rem;
        color: var(--ink-soft);
      }
      .foot__cols a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .foot__status-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.45rem 0.75rem;
        border-top: var(--edge) solid var(--ink);
        background: var(--win-2);
        font-size: 0.72rem;
        color: var(--ink-soft);
      }
      /* The resize grip every old window had in its bottom-right corner. */
      .foot__grip {
        width: 14px;
        height: 14px;
        background-image: linear-gradient(
          135deg,
          transparent 0 42%,
          var(--ink) 42% 55%,
          transparent 55% 72%,
          var(--ink) 72% 85%,
          transparent 85%
        );
      }

      @media (max-width: 760px) {
        .foot__body {
          grid-template-columns: 1fr;
        }
        .foot__cols {
          grid-template-columns: repeat(2, 1fr);
          gap: 1.4rem;
        }
      }
      @media (max-width: 420px) {
        .foot__cols {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
