---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { site } from '../../site'
import '../../styles/prose.css'

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)
  return docs.map((doc, i) => ({
    params: { slug: doc.id },
    props: {
      doc,
      all: docs,
      prev: docs[i - 1],
      next: docs[i + 1],
    },
  }))
}

const { doc, all, prev, next } = Astro.props
const { Content, headings } = await render(doc)

// Only h2/h3 make it into the rail — deeper than that and it stops being a map.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const editUrl = `${site.repo}/blob/main/docs/${doc.id}.md`
---

<Base title={doc.data.title} description={doc.data.summary} wide>
  <div class="docs">
    <!-- ---------- sidebar ---------- -->
    <aside class="side">
      <nav aria-label="Documentation">
        <span class="side__head">Documentation</span>
        <ul>
          {
            all.map((d) => (
              <li>
                <a href={`/docs/${d.id}`} class:list={{ 'is-current': d.id === doc.id }}>
                  <span class="side__n">{String(d.data.order).padStart(2, '0')}</span>
                  {d.data.label}
                </a>
              </li>
            ))
          }
        </ul>

        <span class="side__head side__head--gap">Elsewhere</span>
        <ul>
          <li><a href="/">Overview</a></li>
          <li><a href="/docs">All docs</a></li>
          <li>
            <a href={site.repo} target="_blank" rel="noopener">Repository ↗</a>
          </li>
        </ul>
      </nav>
    </aside>

    <!-- ---------- article ---------- -->
    <article class="doc">
      <header class="doc__head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/docs">Docs</a>
          <Icon name="chevron" size={12} />
          <span>{doc.data.label}</span>
        </nav>
        <h1>{doc.data.title}</h1>
        <p class="doc__sum">{doc.data.summary}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="Pagination">
        {
          prev ? (
            <a class="pager__link pager__link--prev" href={`/docs/${prev.id}`}>
              <span>Previous</span>
              <strong>{prev.data.label}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="pager__link pager__link--next" href={`/docs/${next.id}`}>
              <span>Next</span>
              <strong>{next.data.label}</strong>
            </a>
          )
        }
      </nav>
    </article>

    <!-- ---------- on this page ---------- -->
    <aside class="toc">
      {
        toc.length > 0 && (
          <nav aria-label="On this page">
            <span class="toc__head">On this page</span>
            <ul>
              {toc.map((h) => (
                <li class:list={[`d-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <a class="toc__edit" href={editUrl} target="_blank" rel="noopener">
        <Icon name="github" size={13} /> Edit this page
      </a>
    </aside>
  </div>

  <script>
    // Highlights the heading currently nearest the top of the viewport.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')]
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => Boolean(el))

    if (targets.length) {
      const seen = new Set<string>()

      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) seen.add(e.target.id)
            else seen.delete(e.target.id)
          }

          // Fall back to the last heading scrolled past, so the rail never goes
          // blank between two widely spaced sections.
          let activeId = targets.find((t) => seen.has(t.id))?.id
          if (!activeId) {
            const passed = targets.filter((t) => t.getBoundingClientRect().top < 120)
            activeId = passed.at(-1)?.id
          }

          for (const a of links) {
            a.classList.toggle('is-active', decodeURIComponent(a.hash.slice(1)) === activeId)
          }
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      )

      targets.forEach((t) => spy.observe(t))
    }
  </script>

  <style>
    .docs {
      max-width: 1400px;
      margin-inline: auto;
      padding-inline: var(--gutter);
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr) 210px;
      gap: clamp(1.5rem, 3vw, 2.75rem);
      align-items: start;
    }

    /* ---------- sidebar ---------- */
    .side {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 7.5rem);
      overflow-y: auto;
      padding-block: 2.25rem 2rem;
      scrollbar-width: thin;
    }
    .side nav {
      background: var(--win);
      border: var(--edge) solid var(--ink);
      border-radius: var(--radius);
      box-shadow: var(--drop-sm);
      padding: 0.9rem 0.85rem 1rem;
    }
    .side__head {
      display: block;
      font-family: var(--font-display);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.65rem;
      padding-bottom: 0.5rem;
      border-bottom: var(--edge) solid var(--ink);
    }
    .side__head--gap {
      margin-top: 1.5rem;
    }
    .side ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.12rem;
    }
    .side a {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding: 0.35rem 0.55rem;
      border: var(--edge) solid transparent;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      color: var(--ink-soft);
    }
    .side a:hover {
      background: var(--win-2);
      border-color: var(--ink);
      color: var(--ink);
    }
    .side a.is-current {
      background: var(--title);
      color: var(--title-ink);
      border-color: var(--ink);
      font-weight: 700;
    }
    .side__n {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      opacity: 0.7;
    }

    /* ---------- article ---------- */
    .doc {
      padding-block: 2.25rem 4rem;
      min-width: 0;
    }

    .doc__head {
      padding-bottom: 1.6rem;
      margin-bottom: 2rem;
      border-bottom: var(--edge) solid var(--ink);
    }
    .crumbs {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.75rem;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }
    .crumbs a:hover {
      color: var(--title);
    }
    .doc__head h1 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.75rem, 4.2vw, 2.5rem);
      line-height: 1.16;
      letter-spacing: -0.03em;
    }
    .doc__sum {
      margin-top: 0.85rem;
      font-size: 0.95rem;
      color: var(--ink-soft);
      max-width: 64ch;
      line-height: 1.7;
    }

    /* The first h2 sits right under the header rule, so it needs no own. */
    .doc :global(.prose > h2:first-child) {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    /* ---------- pager ---------- */
    .pager {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: var(--edge) solid var(--ink);
    }
    .pager__link {
      display: grid;
      gap: 0.25rem;
      padding: 0.95rem 1.1rem;
      border: var(--edge) solid var(--ink);
      border-radius: var(--radius);
      background: var(--win);
      box-shadow: var(--drop-sm);
      transition: transform 0.1s linear, box-shadow 0.1s linear, background 0.15s var(--ease);
    }
    .pager__link:hover {
      background: var(--amber);
      transform: translate(-2px, -2px);
      box-shadow: var(--drop);
    }
    .pager__link--next {
      text-align: right;
      grid-column: 2;
    }
    .pager__link span {
      font-family: var(--font-display);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .pager__link strong {
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--ink);
    }

    /* ---------- on this page ---------- */
    .toc {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 7.5rem);
      overflow-y: auto;
      padding-block: 2.25rem 2rem;
      scrollbar-width: thin;
    }
    .toc__head {
      display: block;
      font-family: var(--font-display);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.65rem;
    }
    .toc ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: var(--edge) solid var(--ink);
    }
    .toc li a {
      display: block;
      padding: 0.28rem 0 0.28rem 0.75rem;
      margin-left: calc(var(--edge) * -1);
      border-left: var(--edge) solid transparent;
      font-size: 0.78rem;
      line-height: 1.45;
      color: var(--ink-faint);
    }
    .toc li.d-3 a {
      padding-left: 1.45rem;
      font-size: 0.75rem;
    }
    .toc li a:hover {
      color: var(--ink);
    }
    .toc li a.is-active {
      color: var(--ink);
      font-weight: 700;
      border-left-color: var(--title);
    }
    .toc__edit {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 1.4rem;
      font-size: 0.75rem;
      color: var(--ink-faint);
    }
    .toc__edit:hover {
      color: var(--title);
    }

    /* ---------- responsive ---------- */
    @media (max-width: 1180px) {
      .docs {
        grid-template-columns: 210px minmax(0, 1fr);
      }
      .toc {
        display: none;
      }
    }

    @media (max-width: 900px) {
      .docs {
        grid-template-columns: 1fr;
      }
      .side {
        position: static;
        max-height: none;
        padding-block: 1.5rem 0;
      }
      .side nav {
        padding: 0.75rem;
      }
      .side ul {
        grid-auto-flow: column;
        grid-auto-columns: max-content;
        overflow-x: auto;
        padding-bottom: 0.35rem;
      }
      .side__head--gap,
      .side ul:last-of-type {
        display: none;
      }
      .side a {
        white-space: nowrap;
      }
      .doc {
        padding-top: 1.75rem;
      }
      .pager {
        grid-template-columns: 1fr;
      }
      .pager__link--next {
        grid-column: 1;
      }
    }
  </style>
</Base>
