---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { site } from '../../site'

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)

const paths = [
  {
    goal: 'Using it',
    order: ['checks', 'mcp'],
    note: 'Start with the landing page, then the checks you will actually write.',
  },
  {
    goal: 'Adopting it on a real codebase',
    order: ['scaling', 'checks', 'languages'],
    note: 'A legacy repo needs the grandfathering story before it needs the reference.',
  },
  {
    goal: 'Changing it',
    order: ['architecture', 'workflows', 'contributing'],
    note: 'The seams make sense only once the diamond does.',
  },
]

const byId = Object.fromEntries(docs.map((d) => [d.id, d]))
---

<Base title="Documentation" description="Jasper documentation — the guardrail's architecture, workflows, the ten checks, language support, MCP integration, scaling and contributing." wide>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">documentation</span>
      <h1 class="section-title">Everything Jasper does, <em>and what it does not</em>.</h1>
      <p class="lede">
        How the guardrail is built, what it can express as a machine-checkable rule, and
        where it stops. These pages are the repo's own <code class="k">docs/</code>
        directory, rendered — the same files a contributor reads in the source tree, so
        they cannot drift from it.
      </p>
    </div>
  </section>

  <section class="wrap grid-section">
    <ul class="doc-grid">
      {
        docs.map((doc, i) => (
          <li data-reveal style={`--delay:${i * 60}ms`}>
            <a class="doc-card" href={`/docs/${doc.id}`}>
              <span class="doc-card__n">{String(doc.data.order).padStart(2, '0')}</span>
              <h2>{doc.data.label}</h2>
              <p>{doc.data.summary}</p>
              <span class="doc-card__go">
                Read <Icon name="arrow" size={14} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap paths-section">
    <header class="head" data-reveal>
      <span class="eyebrow">reading order</span>
      <h2 class="section-title">Depends what you came for</h2>
    </header>

    <div class="paths">
      {
        paths.map((p, i) => (
          <div class="path" data-reveal style={`--delay:${i * 90}ms`}>
            <h3>{p.goal}</h3>
            <ol>
              {p.order.map((id) => (
                <li>
                  <a href={`/docs/${id}`}>{byId[id]?.data.label ?? id}</a>
                </li>
              ))}
            </ol>
            <p>{p.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap repo-cta" data-reveal>
    <div>
      <h2>Reading the source is the other half</h2>
      <p>
        48 files, ~5.5k lines of production Go, one dependency. Every check is one file
        in <code class="k">internal/engine/checks/</code>.
      </p>
    </div>
    <a class="btn btn--primary" href={site.repo} target="_blank" rel="noopener">
      <Icon name="github" /> Open the repository
    </a>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.75rem);
  }
  .hero .lede {
    max-width: 60ch;
  }
  .hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    line-height: 1.16;
    letter-spacing: -0.03em;
    margin-top: 1.4rem;
    max-width: 24ch;
  }

  .grid-section {
    padding-bottom: clamp(2.75rem, 6vw, 4rem);
  }

  .doc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 1rem;
  }

  .doc-card {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    background: var(--win);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop-sm);
    padding: 1.2rem 1.25rem 1.15rem;
    transition: transform 0.1s linear, box-shadow 0.1s linear, background 0.15s var(--ease);
  }
  .doc-card:hover {
    background: var(--amber);
    transform: translate(-3px, -3px);
    box-shadow: var(--drop-lg);
  }

  .doc-card__n {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--field);
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    padding: 0.02rem 0.3rem;
    justify-self: start;
  }
  .doc-card h2 {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }
  .doc-card p {
    font-size: 0.83rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }
  .doc-card:hover p {
    color: var(--ink);
  }
  .doc-card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    align-self: end;
  }

  .paths-section {
    padding-block: clamp(2.75rem, 6vw, 4rem);
    border-top: var(--edge) solid var(--ink);
  }
  .head {
    margin-bottom: 2rem;
  }
  .paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
    gap: 1rem;
  }
  .path {
    background: var(--win);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop-sm);
    padding: 1.15rem 1.2rem 1.25rem;
  }
  .path h3 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    padding-bottom: 0.7rem;
    border-bottom: var(--edge) solid var(--ink);
  }
  .path ol {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    counter-reset: s;
    display: grid;
    gap: 0.4rem;
  }
  .path li {
    counter-increment: s;
    display: flex;
    gap: 0.55rem;
    font-size: 0.85rem;
  }
  .path li::before {
    content: counter(s);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-faint);
    padding-top: 0.2rem;
  }
  .path li a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--win-3);
    text-underline-offset: 3px;
  }
  .path li a:hover {
    color: var(--ink);
    text-decoration-color: var(--title);
  }
  .path > p {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
    line-height: 1.6;
  }

  .repo-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    background: var(--amber);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop);
  }
  .repo-cta h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .repo-cta p {
    margin-top: 0.5rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
    max-width: 54ch;
  }
</style>
