---
/**
 * Jasper's own layering. The tidy ladder is a diamond: scan, store, engine and
 * facts are peers, and the PURE / I/O tags are the property that the ladder
 * alone cannot express.
 */

interface N {
  x: number
  y: number
  w: number
  h: number
  name: string
  sub: string
  badge: string
  tone: 'port' | 'svc' | 'io' | 'pure' | 'base'
  delay: number
}

const W = 144
const peers = [46, 222, 398, 574]

const nodes: N[] = [
  { x: 300, y: 28, w: 160, h: 52, name: 'ports', sub: 'cli · mcp', badge: 'L4', tone: 'port', delay: 0 },
  { x: 290, y: 116, w: 180, h: 52, name: 'service', sub: 'orchestration', badge: 'L3', tone: 'svc', delay: 0.5 },
  { x: peers[0], y: 206, w: W, h: 64, name: 'scan', sub: 'the only file reader', badge: 'I/O', tone: 'io', delay: 1.0 },
  { x: peers[1], y: 206, w: W, h: 64, name: 'store', sub: 'yaml → decisions', badge: 'I/O', tone: 'io', delay: 1.1 },
  { x: peers[2], y: 206, w: W, h: 64, name: 'engine', sub: 'Snap → []Finding', badge: 'PURE', tone: 'pure', delay: 1.2 },
  { x: peers[3], y: 206, w: W, h: 64, name: 'facts', sub: 'Snap → []Fact', badge: 'PURE', tone: 'pure', delay: 1.3 },
  { x: 280, y: 330, w: 200, h: 54, name: 'model · glob', sub: 'zero dependencies', badge: 'L0', tone: 'base', delay: 1.9 },
]

const centers = peers.map((x) => x + W / 2)

const edges = [
  { d: 'M380 80 V116', delay: 0.25 },
  ...centers.map((cx, i) => ({ d: `M380 168 V188 H${cx} V206`, delay: 0.75 + i * 0.06 })),
  ...centers.map((cx, i) => ({ d: `M${cx} 270 V292`, delay: 1.5 + i * 0.05 })),
  { d: 'M380 292 V330', delay: 1.8 },
]
---

<figure class="arch" data-anim>
  <div class="arch__scroll scroll-x">
    <svg viewBox="0 0 760 400" role="img" aria-labelledby="arch-t arch-d">
      <title id="arch-t">Jasper's package layering</title>
      <desc id="arch-d">
        ports depends on service, which depends on four peer packages — scan and
        store do I/O, engine and facts are pure — all of which depend only on model
        and glob. The four peers may not import one another.
      </desc>

      <defs>
        <marker id="down" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0.8 L9.2 5 L0 9.2 z" fill="var(--ink)" />
        </marker>
      </defs>

      {
        edges.map((e) => (
          <>
            <path class="wire" d={e.d} pathLength="100" marker-end="url(#down)" style={`--delay:${e.delay}s`} />
            <path class="pulse" d={e.d} pathLength="100" style={`--delay:${e.delay + 1.4}s`} />
          </>
        ))
      }

      <!-- the peer bracket: what a directional rule cannot say -->
      <path class="bracket" d="M118 292 H646" pathLength="100" style="--delay:1.55s" />
      <g class="bracket-tag">
        <rect x="294" y="278" width="172" height="22" rx="3" />
        <text x="380" y="293" text-anchor="middle">peers — no cross-imports</text>
      </g>

      {
        nodes.map((n) => (
          <g class:list={['node', `t-${n.tone}`]} style={`--delay:${n.delay}s`}>
            <rect class="node__shadow" x={n.x + 4} y={n.y + 4} width={n.w} height={n.h} rx="4" />
            <rect class="node__box" x={n.x} y={n.y} width={n.w} height={n.h} rx="4" />
            <text class="n-name" x={n.x + n.w / 2} y={n.y + (n.h > 56 ? 28 : 24)} text-anchor="middle">
              {n.name}
            </text>
            <text class="n-sub" x={n.x + n.w / 2} y={n.y + (n.h > 56 ? 46 : 41)} text-anchor="middle">
              {n.sub}
            </text>
            <g class="badge">
              <rect x={n.x + n.w - 50} y={n.y - 11} width="44" height="20" rx="3" />
              <text x={n.x + n.w - 28} y={n.y + 3} text-anchor="middle">
                {n.badge}
              </text>
            </g>
          </g>
        ))
      }
    </svg>
  </div>

  <!-- Below 860px the diamond stacks: the four peers become a 2x2 band inside a
       dashed "peers" group, which is exactly what the bracket says on desktop. -->
  <ol class="vstack">
    <li class="vrow" style="--i:0">
      <span class="vbox"><b>ports</b><span>cli · mcp</span><i class="tag">L4</i></span>
    </li>
    <li class="vlink" style="--i:1"></li>
    <li class="vrow" style="--i:2">
      <span class="vbox"><b>service</b><span>orchestration</span><i class="tag">L3</i></span>
    </li>
    <li class="vlink" style="--i:3"></li>
    <li class="vpeers" style="--i:4">
      <span class="vpeers__label">peers — no cross-imports</span>
      <span class="vbox vbox--io"><b>scan</b><span>the only file reader</span><i class="tag tag--io">I/O</i></span>
      <span class="vbox vbox--io"><b>store</b><span>yaml → decisions</span><i class="tag tag--io">I/O</i></span>
      <span class="vbox vbox--pure"><b>engine</b><span>Snap → []Finding</span><i class="tag tag--pure">PURE</i></span>
      <span class="vbox vbox--pure"><b>facts</b><span>Snap → []Fact</span><i class="tag tag--pure">PURE</i></span>
    </li>
    <li class="vlink" style="--i:5"></li>
    <li class="vrow" style="--i:6">
      <span class="vbox vbox--base"><b>model · glob</b><span>zero dependencies</span><i class="tag">L0</i></span>
    </li>
  </ol>

  <figcaption>
    <code>engine → scan</code> points <em>downward</em> in the ladder, and is still
    forbidden — because the engine must stay pure and <code>scan</code> does I/O.
    That is a property, not an ordering, which is why Jasper's own layering decision
    is seven explicit rules rather than one tidy <code>layers</code> block.
  </figcaption>
</figure>

<style>
  .arch {
    margin: 0;
  }
  .arch__scroll {
    background: var(--field);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop);
    padding: 1.5rem 1rem 1.25rem;
  }
  .arch svg {
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
    overflow: visible;
  }

  .wire {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 0.5s var(--ease-io) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, running);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .pulse {
    fill: none;
    stroke: var(--title);
    stroke-width: 5;
    stroke-dasharray: 12 88;
    stroke-dashoffset: 100;
    opacity: 0;
    animation: pulse 3.8s linear infinite;
    animation-delay: var(--delay);
    animation-play-state: var(--run, running);
  }
  @keyframes pulse {
    0% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    10%,
    58% {
      opacity: 1;
    }
    70%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  .bracket {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 0.7s var(--ease-io) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, running);
  }
  .bracket-tag {
    opacity: 0;
    animation: fade 0.5s var(--ease) 2.1s forwards;
    animation-play-state: var(--run, running);
  }
  .bracket-tag rect {
    fill: var(--amber);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .bracket-tag text {
    font-size: 10.5px;
    fill: var(--ink);
  }

  .node {
    opacity: 0;
    animation: fade 0.35s var(--ease) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, running);
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  .node__shadow {
    fill: var(--ink);
  }
  .node__box {
    fill: var(--win);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .n-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    fill: var(--ink);
  }
  .n-sub {
    font-size: 9.5px;
    fill: var(--ink-faint);
  }

  .badge rect {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .badge text {
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    fill: var(--ink);
  }

  .t-pure .badge rect {
    fill: var(--green);
  }
  .t-pure .badge text {
    fill: var(--field);
  }
  .t-io .badge rect {
    fill: var(--red);
  }
  .t-io .badge text {
    fill: var(--field);
  }
  .t-port .badge rect,
  .t-svc .badge rect,
  .t-base .badge rect {
    fill: var(--win-3);
  }
  .t-base .node__box {
    fill: var(--amber);
  }
  .t-pure .node__box {
    fill: var(--field);
  }

  figcaption {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    max-width: 64ch;
    line-height: 1.75;
  }
  figcaption code {
    font-size: 0.88em;
    background: var(--win-2);
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    padding: 0.02em 0.3em;
  }
  figcaption em {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
  }

  /* --- vertical variant -------------------------------------------------- */
  .vstack {
    display: none;
    list-style: none;
    margin: 0;
    padding: 1.1rem 0.9rem 1.25rem;
    background: var(--field);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop);
  }

  .vbox {
    position: relative;
    display: block;
    background: var(--win);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop-sm);
    padding: 0.7rem 0.8rem;
    text-align: center;
  }
  .vbox b {
    display: block;
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .vbox > span {
    display: block;
    font-size: 0.7rem;
    color: var(--ink-faint);
    line-height: 1.4;
    margin-top: 0.1rem;
  }
  .vbox--pure {
    background: var(--field);
  }
  .vbox--base {
    background: var(--amber);
  }
  .vbox--base > span {
    color: var(--ink-soft);
  }

  .tag {
    position: absolute;
    top: -0.62rem;
    right: 0.5rem;
    font-family: var(--font-display);
    font-style: normal;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--win-3);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 0.02rem 0.3rem;
  }
  .tag--pure {
    background: var(--green);
    color: var(--field);
  }
  .tag--io {
    background: var(--red);
    color: var(--field);
  }

  .vlink {
    position: relative;
    height: 2rem;
  }
  .vlink::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--ink);
  }
  .vlink::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    margin-left: -5px;
    width: 0;
    height: 0;
    border-inline: 5px solid transparent;
    border-top: 7px solid var(--ink);
  }

  .vpeers {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 1.4rem 0.7rem 0.8rem;
    border: 2px dashed var(--ink);
    border-radius: var(--radius);
  }
  .vpeers__label {
    position: absolute;
    top: -0.68rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--amber);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 0.08rem 0.4rem;
  }

  .vstack > li {
    opacity: 0;
    animation: fade 0.34s var(--ease) forwards;
    animation-delay: calc(var(--i) * 0.11s);
    animation-play-state: var(--run, running);
  }

  @media (max-width: 860px) {
    .arch__scroll {
      display: none;
    }
    .vstack {
      display: grid;
    }
  }

  @media (max-width: 400px) {
    .vpeers {
      grid-template-columns: 1fr;
    }
  }
</style>
