---
/**
 * Jasper's own layering. The tidy ladder is a diamond: scan, store, engine and
 * facts are peers, and the PURE / I/O badges are the property that the ladder
 * alone cannot express.
 */

interface N {
  x: number
  y: number
  w: number
  h: number
  name: string
  sub: string
  badge: string
  tone: 'port' | 'svc' | 'io' | 'pure' | 'base'
  delay: number
}

const W = 140
const peers = [48, 223, 398, 573]

const nodes: N[] = [
  { x: 300, y: 24, w: 160, h: 48, name: 'ports', sub: 'cli · mcp', badge: 'L4', tone: 'port', delay: 0 },
  { x: 290, y: 112, w: 180, h: 48, name: 'service', sub: 'orchestration', badge: 'L3', tone: 'svc', delay: 0.5 },
  { x: peers[0], y: 200, w: W, h: 60, name: 'scan', sub: 'the only reader of files', badge: 'I/O', tone: 'io', delay: 1.0 },
  { x: peers[1], y: 200, w: W, h: 60, name: 'store', sub: 'yaml → decisions', badge: 'I/O', tone: 'io', delay: 1.1 },
  { x: peers[2], y: 200, w: W, h: 60, name: 'engine', sub: 'Snapshot → []Finding', badge: 'PURE', tone: 'pure', delay: 1.2 },
  { x: peers[3], y: 200, w: W, h: 60, name: 'facts', sub: 'Snapshot → []Fact', badge: 'PURE', tone: 'pure', delay: 1.3 },
  { x: 280, y: 318, w: 200, h: 50, name: 'model · glob', sub: 'zero dependencies', badge: 'L0', tone: 'base', delay: 1.9 },
]

const centers = peers.map((x) => x + W / 2)

const edges = [
  { d: 'M380 72 V112', delay: 0.25 },
  ...centers.map((cx, i) => ({ d: `M380 160 V182 H${cx} V200`, delay: 0.75 + i * 0.06 })),
  ...centers.map((cx, i) => ({ d: `M${cx} 260 V282`, delay: 1.5 + i * 0.05 })),
  { d: 'M380 282 V318', delay: 1.8 },
]
---

<figure class="arch" data-anim>
  <svg viewBox="0 0 760 400" role="img" aria-labelledby="arch-t arch-d">
    <title id="arch-t">Jasper's package layering</title>
    <desc id="arch-d">
      ports depends on service, which depends on four peer packages — scan and
      store do I/O, engine and facts are pure — all of which depend only on model
      and glob. The four peers may not import one another.
    </desc>

    <defs>
      <marker id="down" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
        <path d="M0 1.4 L8.6 5 L0 8.6 z" fill="var(--line-strong)" />
      </marker>
    </defs>

    {
      edges.map((e, i) => (
        <>
          <path class="wire" d={e.d} pathLength="100" marker-end="url(#down)" style={`--delay:${e.delay}s`} />
          <path class="comet" d={e.d} pathLength="100" style={`--delay:${e.delay + 1.4}s`} />
        </>
      ))
    }

    <!-- the peer bracket: what a directional rule cannot say -->
    <path class="bracket" d="M118 282 H643" pathLength="100" style="--delay:1.55s" />
    <text class="bracket__label" x="380" y="276" text-anchor="middle">
      peers — none may import another
    </text>

    {
      nodes.map((n) => (
        <g class:list={['node', `t-${n.tone}`]} style={`--delay:${n.delay}s`}>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
          <text class="n-name" x={n.x + n.w / 2} y={n.y + (n.h > 50 ? 27 : 23)} text-anchor="middle">
            {n.name}
          </text>
          <text class="n-sub" x={n.x + n.w / 2} y={n.y + (n.h > 50 ? 45 : 40)} text-anchor="middle">
            {n.sub}
          </text>
          <g class="badge">
            <rect x={n.x + n.w - 48} y={n.y - 9} width="42" height="18" rx="9" />
            <text x={n.x + n.w - 27} y={n.y + 4} text-anchor="middle">
              {n.badge}
            </text>
          </g>
        </g>
      ))
    }
  </svg>

  <figcaption>
    <code>engine → scan</code> points <em>downward</em> in the ladder, and is still
    forbidden — because the engine must stay pure and <code>scan</code> does I/O.
    That is a property, not an ordering, which is why Jasper's own layering decision
    is seven explicit rules rather than one tidy <code>layers</code> block.
  </figcaption>
</figure>

<style>
  .arch {
    margin: 0;
  }
  .arch svg {
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .wire {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 0.55s var(--ease-io) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .comet {
    fill: none;
    stroke: var(--amber);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 14 86;
    stroke-dashoffset: 100;
    opacity: 0;
    filter: drop-shadow(0 0 4px var(--amber));
    animation: comet 3.8s linear infinite;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  @keyframes comet {
    0% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    10%,
    55% {
      opacity: 0.8;
    }
    68%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  .bracket {
    fill: none;
    stroke: var(--amber-deep);
    stroke-width: 1.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 0.8s var(--ease-io) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  .bracket__label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--amber-deep);
    letter-spacing: 0.03em;
    opacity: 0;
    animation: fade 0.6s var(--ease) 2.1s forwards;
    animation-play-state: var(--run, paused);
  }

  .node {
    opacity: 0;
    transform: translateY(8px);
    animation: rise 0.55s var(--ease) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  .node rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1.5;
    transition: stroke 0.3s var(--ease);
  }
  .node:hover rect {
    stroke: var(--amber);
  }

  .n-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    fill: var(--fg);
  }
  .n-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--fg-faint);
  }

  .badge rect {
    stroke-width: 1;
  }
  .badge text {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .t-pure .badge rect {
    fill: color-mix(in oklab, var(--pass) 16%, var(--bg));
    stroke: color-mix(in oklab, var(--pass) 55%, transparent);
  }
  .t-pure .badge text {
    fill: var(--pass);
  }
  .t-pure rect:first-child {
    fill: color-mix(in oklab, var(--pass) 6%, var(--surface));
  }

  .t-io .badge rect {
    fill: color-mix(in oklab, var(--fail) 14%, var(--bg));
    stroke: color-mix(in oklab, var(--fail) 50%, transparent);
  }
  .t-io .badge text {
    fill: var(--fail);
  }

  .t-port .badge rect,
  .t-svc .badge rect,
  .t-base .badge rect {
    fill: var(--surface-3);
    stroke: var(--line-strong);
  }
  .t-port .badge text,
  .t-svc .badge text,
  .t-base .badge text {
    fill: var(--fg-faint);
  }

  .t-base rect:first-child {
    fill: color-mix(in oklab, var(--amber) 8%, var(--surface));
    stroke: color-mix(in oklab, var(--amber) 40%, var(--line));
  }

  figcaption {
    margin-top: 1.6rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
    max-width: 62ch;
    line-height: 1.7;
  }
  figcaption code {
    color: var(--amber);
    font-size: 0.88em;
  }
  figcaption em {
    color: var(--fg);
    font-style: italic;
  }

  @media (max-width: 760px) {
    .arch {
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .arch svg {
      min-width: 700px;
    }
  }
</style>
