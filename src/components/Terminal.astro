---
import Icon from './Icon.astro'

export type Tone = 'fail' | 'pass' | 'dim' | 'accent' | 'plain' | 'blank'
export interface Line {
  text?: string
  tone?: Tone
  /** leading indent in ch units */
  pad?: number
}

interface Props {
  command: string
  lines: Line[]
  title?: string
  /** seconds the command "types" for before output begins */
  type?: number
  class?: string
  copy?: boolean
}

const {
  command,
  lines,
  title = 'terminal',
  type = 1.1,
  class: klass = '',
  copy = true,
} = Astro.props

const STAGGER = 0.085
---

<div class:list={['win term', klass]} data-anim>
  <div class="win__bar">
    <span class="win__title">{title}</span>
    {
      copy && (
        <button class="term__copy" type="button" data-copy={command} aria-label="Copy command">
          <Icon name="copy" size={13} class="c-copy" />
          <Icon name="check" size={13} class="c-check" />
        </button>
      )
    }
    <span class="win__ctl" aria-hidden="true">
      <i /><i /><i />
    </span>
  </div>

  <div class="term__scroll scroll-x">
    <pre class="term__body"><code><span class="term__cmd" style={`--type:${type}s; --chars:${command.length}`}><span class="term__prompt">$</span> <span class="term__typed">{command}</span></span>{
      lines.map((line, i) => (
        <span
          class:list={['term__line', `t-${line.tone ?? 'plain'}`]}
          style={`--delay:${(type + 0.18 + i * STAGGER).toFixed(2)}s`}
        >{'\n'}{' '.repeat(line.pad ?? 0)}{line.text ?? ''}</span>
      ))
    }<span class="term__caret" style={`--delay:${(type + 0.2 + lines.length * STAGGER).toFixed(2)}s`}></span></code></pre>
  </div>
</div>

<style>
  .term__copy {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    color: inherit;
  }
  .term__copy:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .term__copy > :global(svg) {
    grid-area: 1 / 1;
  }
  .term__copy :global(.c-check) {
    opacity: 0;
  }
  .term__copy.is-copied :global(.c-copy) {
    opacity: 0;
  }
  .term__copy.is-copied :global(.c-check) {
    opacity: 1;
  }

  /* The console sheet: paper-white, like everything else on this desktop. */
  .term__scroll {
    background: var(--field);
    max-width: 100%;
  }

  .term__body {
    margin: 0;
    padding: 1rem 1.1rem 1.25rem;
    font-family: var(--font-mono);
    /* Shrinks on a phone so more of each line lands before the scroll. */
    font-size: clamp(0.62rem, 2.4vw, 0.78rem);
    line-height: 1.75;
    tab-size: 2;
    color: var(--ink-soft);
    width: max-content;
    min-width: 100%;
  }

  /* --- the typed command ------------------------------------------------- */
  .term__cmd {
    display: inline-block;
    color: var(--ink);
    font-weight: 700;
  }
  .term__prompt {
    color: var(--title);
    user-select: none;
  }
  .term__typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    width: 0;
    animation: type var(--type) steps(var(--chars), end) forwards;
    animation-play-state: var(--run, running);
  }
  @keyframes type {
    to {
      width: calc(var(--chars) * 1ch);
    }
  }

  /* --- output lines ------------------------------------------------------ */
  .term__line {
    display: inline;
    opacity: 0;
    animation: line-in 0.01s linear forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, running);
  }
  @keyframes line-in {
    to {
      opacity: 1;
    }
  }

  .t-fail {
    color: var(--red);
    font-weight: 700;
  }
  .t-pass {
    color: var(--green);
    font-weight: 700;
  }
  .t-accent {
    color: var(--title);
  }
  .t-dim {
    color: var(--ink-faint);
  }
  .t-plain {
    color: var(--ink-soft);
  }

  .term__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    background: var(--title);
    vertical-align: text-bottom;
    opacity: 0;
    animation: caret-on 0.01s linear forwards, blink 1.05s steps(2, start) infinite;
    animation-delay: var(--delay), var(--delay);
    animation-play-state: var(--run, running);
  }
  @keyframes caret-on {
    to {
      opacity: 1;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term__typed {
      width: auto !important;
    }
    .term__line {
      opacity: 1 !important;
    }
    .term__caret {
      display: none;
    }
  }
</style>
