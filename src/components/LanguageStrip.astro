---
const langs = [
  {
    name: 'Go',
    ext: '.go',
    how: 'go/parser — the standard library, exact',
    manifest: 'go.mod',
    resolve: 'module path → package directory',
    exact: true,
  },
  {
    name: 'TypeScript / JS',
    ext: '.ts .tsx .js .mjs …',
    how: 'hand-written tokenizer',
    manifest: 'package.json',
    resolve: 'relative paths + tsconfig aliases',
    exact: false,
  },
  {
    name: 'Python',
    ext: '.py .pyi',
    how: 'comment blanking + statement match',
    manifest: 'requirements.txt · pyproject · Pipfile',
    resolve: 'dotted paths, relative imports, src/ layout',
    exact: false,
  },
  {
    name: 'Rust',
    ext: '.rs',
    how: 'comment blanking + use match',
    manifest: 'Cargo.toml',
    resolve: 'crate:: / self:: / super::, longest prefix',
    exact: false,
  },
]
---

<ul class="langs">
  {
    langs.map((l, i) => (
      <li class="lang" data-reveal style={`--delay:${i * 70}ms`}>
        <div class="lang__top">
          <h3>{l.name}</h3>
          <code>{l.ext}</code>
        </div>
        <dl>
          <div>
            <dt>imports via</dt>
            <dd>
              {l.how}
              {l.exact && <span class="pill">exact</span>}
            </dd>
          </div>
          <div>
            <dt>manifest</dt>
            <dd>
              <code>{l.manifest}</code>
            </dd>
          </div>
          <div>
            <dt>resolution</dt>
            <dd>{l.resolve}</dd>
          </div>
        </dl>
      </li>
    ))
  }
</ul>

<style>
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
    gap: 1rem;
  }

  .lang {
    background: var(--win);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop-sm);
    padding: 1.15rem 1.2rem 1.25rem;
    transition: transform 0.1s linear, box-shadow 0.1s linear;
  }
  .lang:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--drop);
  }

  .lang__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-bottom: 0.85rem;
    margin-bottom: 0.95rem;
    border-bottom: var(--edge) solid var(--ink);
  }
  .lang__top h3 {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
  }
  .lang__top code {
    font-size: 0.66rem;
    color: var(--ink-faint);
    background: var(--field);
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    padding: 0.05rem 0.3rem;
    white-space: nowrap;
  }

  dl {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }
  dt {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  dd {
    margin: 0.22rem 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  dd code {
    font-size: 0.82em;
    color: var(--ink);
  }

  .pill {
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--field);
    background: var(--green);
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    padding: 0.05rem 0.3rem;
  }
</style>
