---
/**
 * The cycle is the product: code → init → YAML → brief/MCP → agent → code → check.
 *
 * Edges are drawn once on entry, then a short "comet" dash runs the same path on
 * a loop. Normalising every path with pathLength="100" means one keyframe block
 * drives every edge regardless of its real length.
 */

type Kind = 'plain' | 'cmd' | 'key' | 'gate'
interface Node {
  x: number
  y: number
  w: number
  h: number
  title: string
  sub?: string[]
  kind: Kind
  mono?: boolean
  delay: number
}

const nodes: Node[] = [
  { x: 40, y: 40, w: 190, h: 62, title: 'your codebase', sub: ['Go · TS · Python · Rust'], kind: 'plain', delay: 0 },
  { x: 330, y: 40, w: 190, h: 62, title: 'jasper init', sub: ['observe — never invent'], kind: 'cmd', mono: true, delay: 0.35 },
  { x: 620, y: 40, w: 220, h: 62, title: '.jasper/decisions/*.yaml', sub: ['committed to git'], kind: 'key', mono: true, delay: 0.7 },
  { x: 40, y: 190, w: 190, h: 78, title: 'jasper brief', sub: ['static constraints', 'appended to CLAUDE.md'], kind: 'cmd', mono: true, delay: 1.3 },
  { x: 330, y: 190, w: 190, h: 78, title: 'MCP pre-flight', sub: ['the agent asks', 'before it writes'], kind: 'cmd', delay: 1.45 },
  { x: 620, y: 190, w: 220, h: 78, title: 'jasper check', sub: ['the gate —', 'exit 1 on violation'], kind: 'gate', mono: true, delay: 1.6 },
  { x: 330, y: 350, w: 190, h: 62, title: 'the agent writes code', kind: 'plain', delay: 2.2 },
]

/** Orthogonal routing. Sharp corners — this is a wiring diagram, not a bubble chart. */
const edges = [
  { d: 'M230 71 H330', delay: 0.2 },
  { d: 'M520 71 H620', delay: 0.55 },
  { d: 'M730 102 V190', delay: 0.95 },
  { d: 'M730 102 V160 H425 V190', delay: 1.05 },
  { d: 'M730 102 V160 H135 V190', delay: 1.15 },
  { d: 'M425 268 V350', delay: 1.9 },
  { d: 'M135 268 V320 H425 V350', delay: 2.0 },
  { d: 'M730 268 V320 H425 V350', delay: 2.05 },
]

const returnEdge = { d: 'M425 412 V446 H14 V71 H40', delay: 2.5 }
---

<figure class="loop" data-anim>
  <svg viewBox="0 0 880 480" role="img" aria-labelledby="loop-t loop-d">
    <title id="loop-t">The Jasper loop</title>
    <desc id="loop-d">
      Your codebase feeds jasper init, which proposes decisions into
      .jasper/decisions. Those decisions are consumed three ways — jasper brief,
      the MCP pre-flight tools, and jasper check — all of which shape what the
      agent writes, which becomes the codebase again.
    </desc>

    <defs>
      <marker id="tip" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 1.2 L9 5 L0 8.8 z" fill="var(--line-strong)" />
      </marker>
    </defs>

    <!-- edges -->
    <g class="edges">
      {
        [...edges, returnEdge].map((e, i) => (
          <>
            <path
              class:list={['wire', { 'wire--return': i === edges.length }]}
              d={e.d}
              pathLength="100"
              marker-end="url(#tip)"
              style={`--delay:${e.delay}s`}
            />
            <path
              class="comet"
              d={e.d}
              pathLength="100"
              style={`--delay:${e.delay + 0.9}s; --i:${i}`}
            />
          </>
        ))
      }
    </g>

    <text class="edge-note" x="200" y="466">a new architectural choice — propose_decision, or a human edit</text>

    <!-- nodes -->
    {
      nodes.map((n) => (
        <g class:list={['node', `n-${n.kind}`]} style={`--delay:${n.delay}s`}>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
          <text
            class:list={['n-title', { mono: n.mono }]}
            x={n.x + n.w / 2}
            y={n.sub ? n.y + (n.sub.length > 1 ? 27 : 28) : n.y + 37}
            text-anchor="middle"
          >
            {n.title}
          </text>
          {n.sub?.map((line, si) => (
            <text class="n-sub" x={n.x + n.w / 2} y={n.y + (n.sub!.length > 1 ? 47 : 46) + si * 14} text-anchor="middle">
              {line}
            </text>
          ))}
        </g>
      ))
    }
  </svg>

  <figcaption>
    Four separate commands, none of them a daemon. Jasper is a gate you position,
    not a guard that patrols.
  </figcaption>
</figure>

<style>
  .loop {
    margin: 0;
  }
  .loop svg {
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  /* --- wires ------------------------------------------------------------- */
  .wire {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw 0.7s var(--ease-io) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  .wire--return {
    stroke-dasharray: 5 4;
    stroke-dashoffset: 0;
    opacity: 0;
    animation: fade-in 0.8s var(--ease) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* A short lit segment runs the wire forever, so the diagram reads as flow
     rather than as a static picture of boxes. */
  .comet {
    fill: none;
    stroke: var(--amber);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 9 91;
    stroke-dashoffset: 100;
    opacity: 0;
    filter: drop-shadow(0 0 4px var(--amber));
    animation: comet 3.4s linear infinite;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  @keyframes comet {
    0% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    8%,
    60% {
      opacity: 0.85;
    }
    72%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  /* --- nodes ------------------------------------------------------------- */
  .node {
    opacity: 0;
    transform: translateY(10px);
    animation: rise 0.6s var(--ease) forwards;
    animation-delay: var(--delay);
    animation-play-state: var(--run, paused);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  .node rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1.5;
    transition: stroke 0.3s var(--ease), fill 0.3s var(--ease);
  }
  .node:hover rect {
    stroke: var(--amber-deep);
  }

  .n-title {
    font-size: 14px;
    font-weight: 600;
    fill: var(--fg);
  }
  .n-title.mono {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
  }
  .n-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--fg-faint);
    letter-spacing: 0.02em;
  }

  .n-key rect {
    fill: color-mix(in oklab, var(--amber) 11%, var(--surface));
    stroke: var(--amber);
  }
  .n-key .n-title {
    fill: var(--amber);
  }
  .n-gate rect {
    fill: color-mix(in oklab, var(--pass) 8%, var(--surface));
    stroke: color-mix(in oklab, var(--pass) 60%, var(--line));
  }
  .n-cmd .n-title {
    fill: var(--fg);
  }

  .edge-note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--fg-faint);
    opacity: 0;
    animation: fade-in 0.6s var(--ease) 3s forwards;
    animation-play-state: var(--run, paused);
  }

  figcaption {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
    max-width: 58ch;
    line-height: 1.7;
  }

  /* On a phone the diagram scrolls horizontally rather than shrinking to
     illegibility. */
  @media (max-width: 720px) {
    .loop {
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .loop svg {
      min-width: 720px;
    }
    figcaption {
      min-width: 0;
    }
  }
</style>
