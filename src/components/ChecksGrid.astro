---
/** Ten primitives, grouped by what each one has to read to reach a verdict. */

const groups = [
  {
    reads: 'the import graph',
    note: 'resolved edges between real files',
    checks: [
      ['no_import', 'a specific forbidden edge between two globs'],
      ['layers', 'a whole dependency direction, plus peer isolation, in one rule'],
      ['public_api', 'anything reaching past a module’s entry point'],
      ['no_cycles', 'circular dependencies between directories'],
      ['confine', 'a driver or library escaping the layer that owns it'],
      ['require_import', 'a file that fails to import something mandatory'],
    ],
  },
  {
    reads: 'the manifest',
    note: 'go.mod · package.json · pyproject · Cargo.toml',
    checks: [
      ['forbid_dependency', 'a technology choice being quietly reversed'],
      ['approved_dependencies', 'any package added without a decision'],
      ['max_dependencies', 'a dependency budget being exceeded'],
    ],
  },
  {
    reads: 'source text',
    note: 'loaded lazily, only when a text rule exists',
    checks: [['forbid_text', 'process.env outside config, debug logging in prod']],
  },
]

let n = 0
---

<div class="checks">
  {
    groups.map((g) => (
      <section class="group">
        <header class="group__head" data-reveal>
          <h3>{g.reads}</h3>
          <span>{g.note}</span>
        </header>
        <ul class="group__list">
          {g.checks.map(([name, catches]) => (
            <li class="chk" data-reveal style={`--delay:${(n++ % 6) * 60}ms`}>
              <code class="chk__name">{name}</code>
              <p class="chk__catches">{catches}</p>
              <span class="chk__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="13" height="13">
                  <path
                    d="M3 8h10m0 0-3.6-3.6M13 8l-3.6 3.6"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .checks {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
  }

  .group__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    padding-bottom: 0.8rem;
    margin-bottom: 1.25rem;
    border-bottom: var(--edge) solid var(--ink);
  }
  .group__head h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .group__head span {
    font-size: 0.74rem;
    color: var(--ink-faint);
    background: var(--win-2);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.5rem;
  }

  .group__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .chk {
    position: relative;
    background: var(--win);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop-sm);
    padding: 1rem 1.1rem;
    transition: transform 0.1s linear, box-shadow 0.1s linear, background 0.15s var(--ease);
  }
  .chk:hover {
    background: var(--amber);
    transform: translate(-2px, -2px);
    box-shadow: var(--drop);
  }

  .chk__name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--field);
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    padding: 0.05rem 0.35rem;
  }
  .chk__catches {
    margin-top: 0.7rem;
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .chk:hover .chk__catches {
    color: var(--ink);
  }
  .chk__arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    opacity: 0;
    transition: opacity 0.15s var(--ease);
  }
  .chk:hover .chk__arrow {
    opacity: 1;
  }
</style>
