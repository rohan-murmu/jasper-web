---
/**
 * One decision file, three audiences. The highlight cycles on a 9s loop so the
 * relationship between the legend and the YAML is shown rather than described;
 * hovering a legend entry pins its region.
 */

const parts = [
  {
    key: 'why',
    field: 'why',
    audience: 'the human reading it in six months',
    body: 'Rationale, the alternatives that lost, and the failure this prevents. Nothing here executes.',
  },
  {
    key: 'brief',
    field: 'brief',
    audience: 'the coding agent, before it starts',
    body: 'About sixty tokens of constraint — small enough to sit in every prompt without crowding the task out.',
  },
  {
    key: 'enforce',
    field: 'enforce',
    audience: 'CI, and the agent’s pre-flight',
    body: 'Checks that exit non-zero. A decision with no enforce block is a note, not a rule, and Jasper renders it as one.',
  },
]
---

<div class="anatomy" data-anim>
  <ul class="legend">
    {
      parts.map((p, i) => (
        <li class:list={['lg', `lg--${p.key}`]} style={`--i:${i}`}>
          <span class="lg__field">{p.field}</span>
          <span class="lg__aud">{p.audience}</span>
          <p class="lg__body">{p.body}</p>
        </li>
      ))
    }
  </ul>

  <div class="win file">
    <div class="win__bar">
      <span class="win__title">002-datastore.yaml</span>
      <span class="win__ctl" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <pre class="file__code"><code><span class="c-k">id</span>: <span class="c-v">DEC-002</span>
<span class="c-k">title</span>: <span class="c-v">Datastore is PostgreSQL</span>
<span class="c-k">status</span>: <span class="c-v">accepted</span>          <span class="c-c"># accepted | proposed | superseded</span>
<span class="c-k">origin</span>: <span class="c-v">observed</span>          <span class="c-c"># observed | proposed | authored</span>
<span class="c-k">date</span>: <span class="c-v">2026-09-16</span>
<span class="rg rg--why"><span class="c-k">why</span>: |
  Billing needs transactions across rows. A second datastore arriving
  quietly splits transactions, backups and on-call knowledge before
  anyone reviews it.</span>
<span class="rg rg--brief"><span class="c-k">brief</span>: |
  Persistence is PostgreSQL. The pg driver stays behind src/db/**.
  Another datastore requires superseding this decision.</span>
<span class="rg rg--enforce"><span class="c-k">enforce</span>:
  - <span class="c-k">forbid_dependency</span>:
      <span class="c-k">packages</span>: [<span class="c-v">mongodb</span>, <span class="c-v">mongoose</span>, <span class="c-v">mysql2</span>]
      <span class="c-k">message</span>: <span class="c-s">"this project stores data in PostgreSQL"</span>
  - <span class="c-k">confine</span>:
      <span class="c-k">package</span>: <span class="c-v">pg</span>
      <span class="c-k">to</span>: <span class="c-s">"src/db/**"</span></span>

<span class="c-k">affects</span>: [<span class="c-v">billing</span>, <span class="c-v">db</span>]</code></pre>
  </div>
</div>

<style>
  .anatomy {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* --- legend ------------------------------------------------------------ */
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    position: sticky;
    top: 6.5rem;
  }

  .lg {
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    background: var(--win);
    box-shadow: var(--drop-sm);
    cursor: default;
    animation: lg-cycle 9s steps(1, end) infinite;
    animation-delay: calc(var(--i) * -3s);
    animation-play-state: var(--run, running);
  }

  @keyframes lg-cycle {
    0% {
      background: var(--amber);
      transform: translate(-2px, -2px);
      box-shadow: var(--drop);
    }
    33.33% {
      background: var(--win);
      transform: none;
      box-shadow: var(--drop-sm);
    }
    100% {
      background: var(--win);
      transform: none;
      box-shadow: var(--drop-sm);
    }
  }

  .lg__field {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }
  .lg__aud {
    display: block;
    font-size: 0.76rem;
    color: var(--ink-faint);
    margin-top: 0.15rem;
  }
  .lg__body {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* --- file window ------------------------------------------------------- */
  .file {
    box-shadow: var(--drop);
  }
  .file__code {
    margin: 0;
    padding: 1rem 0;
    background: var(--field);
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.3vw, 0.75rem);
    line-height: 1.75;
    overflow-x: auto;
    color: var(--ink-soft);
  }
  .file__code code {
    display: block;
    padding-inline: 1rem;
    font-size: inherit;
    width: max-content;
    min-width: 100%;
  }

  .c-k {
    color: var(--purple);
    font-weight: 700;
  }
  .c-v {
    color: var(--ink);
  }
  .c-s {
    color: var(--green);
  }
  .c-c {
    color: var(--ink-faint);
  }

  /* --- the cycling highlight -------------------------------------------- */
  .rg {
    display: block;
    margin-inline: -1rem;
    padding-inline: calc(1rem - 4px);
    border-left: 4px solid transparent;
    animation: rg-cycle 9s steps(1, end) infinite;
    animation-play-state: var(--run, running);
  }
  .rg--why {
    animation-delay: 0s;
  }
  .rg--brief {
    animation-delay: -3s;
  }
  .rg--enforce {
    animation-delay: -6s;
  }

  @keyframes rg-cycle {
    0% {
      background: var(--amber);
      border-left-color: var(--ink);
      opacity: 1;
    }
    33.33% {
      background: transparent;
      border-left-color: transparent;
      opacity: 0.5;
    }
    100% {
      background: transparent;
      border-left-color: transparent;
      opacity: 0.5;
    }
  }

  /* Hovering a legend entry pins its region and stops the carousel. */
  .anatomy:has(.lg--why:hover) .rg--why,
  .anatomy:has(.lg--brief:hover) .rg--brief,
  .anatomy:has(.lg--enforce:hover) .rg--enforce {
    animation: none;
    background: var(--amber);
    border-left-color: var(--ink);
    opacity: 1;
  }
  .anatomy:has(.lg--why:hover) .rg--brief,
  .anatomy:has(.lg--why:hover) .rg--enforce,
  .anatomy:has(.lg--brief:hover) .rg--why,
  .anatomy:has(.lg--brief:hover) .rg--enforce,
  .anatomy:has(.lg--enforce:hover) .rg--why,
  .anatomy:has(.lg--enforce:hover) .rg--brief {
    animation: none;
    background: transparent;
    border-left-color: transparent;
    opacity: 0.45;
  }
  .lg:hover {
    animation: none;
    background: var(--amber);
    transform: translate(-2px, -2px);
    box-shadow: var(--drop);
    cursor: pointer;
  }

  /* The unhovered entries drop back to the resting panel so the hovered one is
     unambiguously the selected row. */
  .anatomy:has(.lg:hover) .lg:not(:hover) {
    animation: none;
    background: var(--win);
    transform: none;
    box-shadow: var(--drop-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .rg {
      opacity: 1 !important;
      border-left-color: var(--ink) !important;
    }
  }

  @media (max-width: 900px) {
    .anatomy {
      grid-template-columns: 1fr;
    }
    .legend {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    }
  }
</style>
