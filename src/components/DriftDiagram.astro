---
/**
 * The problem, in one picture: what was agreed stays put, the code walks away,
 * and every mechanical gate keeps saying yes the whole time.
 */
---

<figure class="drift" data-anim>
  <div class="drift__scroll scroll-x">
    <svg viewBox="0 0 760 372" role="img" aria-labelledby="drift-t drift-d">
      <title id="drift-t">Architectural drift over six weeks</title>
      <desc id="drift-d">
        The recorded decision holds a straight line while the codebase curves away
        from it. The compiler and the test suite keep passing throughout; only the
        question "is this what we agreed?" comes back false.
      </desc>

      <defs>
        <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" stroke="var(--red)" stroke-width="3" opacity="0.32" />
        </pattern>
      </defs>

      <!-- time axis -->
      <line class="axis" x1="70" y1="306" x2="700" y2="306" />
      {
        [
          [70, 'day one', 'start'],
          [290, 'week two', 'middle'],
          [510, 'week four', 'middle'],
          [694, 'week six', 'end'],
        ].map(([x, label, anchor]) => (
          <g class="tick">
            <line x1={x} y1="300" x2={x} y2="312" />
            <text x={x} y="330" text-anchor={anchor as string}>
              {label}
            </text>
          </g>
        ))
      }

      <!-- the widening gap between intent and code -->
      <path
        class="gap"
        d="M70 126 H700 V238 C560 238 400 166 240 128 C180 116 120 124 70 126 Z"
        fill="url(#hatch)"
      />

      <!-- what was agreed: a straight line that does not move -->
      <line class="agreed" x1="70" y1="126" x2="700" y2="126" />
      <g class="label label--agreed">
        <text x="70" y="108">what we agreed</text>
        <text class="sub" x="70" y="92">.jasper/decisions/001-boundaries.yaml</text>
      </g>

      <!-- what the code actually did -->
      <path
        class="code"
        d="M70 126 C120 124 180 116 240 128 C400 166 560 238 700 238"
        fill="none"
      />
      <g class="label label--code">
        <text x="700" y="268" text-anchor="end">what the code does</text>
      </g>

      <!-- commits along the way: each one individually reasonable -->
      {
        [
          [240, 128],
          [370, 158],
          [480, 196],
          [590, 220],
        ].map(([cx, cy], i) => <rect class="commit" x={cx - 5} y={cy - 5} width="10" height="10" style={`--i:${i}`} />)
      }
      <rect class="head" x="694" y="232" width="12" height="12" />

      <!-- the verdicts -->
      <g class="verdicts">
        <g class="verdict" style="--i:0">
          <rect class="vs" x="74" y="22" width="152" height="36" rx="3" />
          <rect class="vb" x="70" y="18" width="152" height="36" rx="3" />
          <text x="86" y="41">compiler</text>
          <text class="mark ok" x="200" y="42">✓</text>
        </g>
        <g class="verdict" style="--i:1">
          <rect class="vs" x="242" y="22" width="152" height="36" rx="3" />
          <rect class="vb" x="238" y="18" width="152" height="36" rx="3" />
          <text x="254" y="41">test suite</text>
          <text class="mark ok" x="368" y="42">✓</text>
        </g>
        <g class="verdict verdict--bad" style="--i:2">
          <rect class="vs" x="410" y="22" width="220" height="36" rx="3" />
          <rect class="vb" x="406" y="18" width="220" height="36" rx="3" />
          <text x="422" y="41">is this what we agreed?</text>
          <text class="mark bad" x="604" y="42">✗</text>
        </g>
      </g>

      <!-- the callout -->
      <g class="drift-tag">
        <line x1="470" y1="130" x2="470" y2="192" />
        <rect x="480" y="148" width="62" height="24" rx="3" />
        <text x="511" y="165" text-anchor="middle">DRIFT</text>
      </g>
    </svg>
  </div>

  <!-- Below 860px the same chart is redrawn portrait: time runs down instead of
       across, so it fits a phone at full label size. -->
  <div class="drift__portrait">
    <svg viewBox="0 0 320 470" role="img" aria-labelledby="drift-mt">
      <title id="drift-mt">Architectural drift over six weeks</title>

      <defs>
        <pattern id="hatch-v" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" stroke="var(--red)" stroke-width="3" opacity="0.32" />
        </pattern>
      </defs>

      <text class="m-head" x="10" y="16">what we agreed</text>
      <text class="m-sub" x="10" y="31">001-boundaries.yaml</text>

      <!-- the gap between the two tracks -->
      <path class="m-gap" d="M70 44 V430 H236 C150 150 70 92 70 44 Z" fill="url(#hatch-v)" />

      <!-- agreed: a straight track that does not move -->
      <line class="m-agreed" x1="70" y1="44" x2="70" y2="430" />

      <!-- code: pulls away to the right -->
      <path class="m-code" d="M70 44 C70 92 150 150 236 430" fill="none" />

      {[[84, 85], [121, 150], [174, 258], [210, 352]].map(([cx, cy], i) => (
        <rect class="m-commit" x={cx - 5} y={cy - 5} width="10" height="10" style={`--i:${i}`} />
      ))}
      <rect class="m-head-sq" x="230" y="424" width="12" height="12" />

      <!-- time runs down the left edge -->
      {[[44, 'day one'], [172, 'week two'], [300, 'week four'], [428, 'week six']].map(([y, label]) => (
        <g class="m-tick">
          <line x1="58" y1={y} x2="70" y2={y} />
          <text x="54" y={(y as number) + 4} text-anchor="end">{label}</text>
        </g>
      ))}

      <g class="m-drift">
        <rect x="88" y="240" width="62" height="24" rx="3" />
        <text x="119" y="257" text-anchor="middle">DRIFT</text>
      </g>

      <text class="m-code-label" x="310" y="452" text-anchor="end">what the code does</text>
    </svg>

    <ul class="m-verdicts">
      <li><span>compiler</span><b class="ok">✓</b></li>
      <li><span>test suite</span><b class="ok">✓</b></li>
      <li class="is-bad"><span>is this what we agreed?</span><b class="bad">✗</b></li>
    </ul>
  </div>

  <figcaption>
    Every commit on that curve compiled, passed review and passed CI. Drift is, by
    definition, made of changes that nothing mechanical objects to.
  </figcaption>
</figure>

<style>
  .drift {
    margin: 0;
  }
  .drift__scroll {
    background: var(--field);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop);
    padding: 1.25rem 1rem;
  }
  .drift svg {
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
    overflow: visible;
  }

  .axis {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .tick line {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .tick text {
    font-size: 11px;
    fill: var(--ink-faint);
  }

  /* --- the agreed line: drawn first, then holds ------------------------- */
  .agreed {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-dasharray: 8 6;
    stroke-dashoffset: 660;
    animation: draw-agreed 0.9s var(--ease-io) forwards;
    animation-play-state: var(--run, running);
  }
  @keyframes draw-agreed {
    to {
      stroke-dashoffset: 0;
    }
  }

  .label text {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    fill: var(--ink);
  }
  .label .sub {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    fill: var(--ink-faint);
  }
  .label {
    opacity: 0;
    animation: fade 0.4s var(--ease) forwards;
    animation-play-state: var(--run, running);
  }
  .label--agreed {
    animation-delay: 0.5s;
  }
  .label--code {
    animation-delay: 2.5s;
  }

  /* --- the code path: drawn slowly, pulling away ------------------------ */
  .code {
    stroke: var(--red);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
    animation: draw-code 2.2s var(--ease-io) 0.75s forwards;
    animation-play-state: var(--run, running);
  }
  @keyframes draw-code {
    to {
      stroke-dashoffset: 0;
    }
  }

  .head {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 2;
    opacity: 0;
    animation: fade 0.3s var(--ease) 2.7s forwards;
    animation-play-state: var(--run, running);
  }

  .commit {
    fill: var(--amber);
    stroke: var(--ink);
    stroke-width: 2;
    opacity: 0;
    animation: fade 0.25s var(--ease) forwards;
    animation-delay: calc(1.1s + var(--i) * 0.42s);
    animation-play-state: var(--run, running);
  }

  .gap {
    opacity: 0;
    animation: fade 0.8s var(--ease) 2.3s forwards;
    animation-play-state: var(--run, running);
  }

  /* --- verdict panels ---------------------------------------------------- */
  .verdict .vs {
    fill: var(--ink);
  }
  .verdict .vb {
    fill: var(--win);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .verdict text {
    font-size: 12.5px;
    fill: var(--ink);
  }
  .verdict .mark {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
  }
  .verdict .ok {
    fill: var(--green);
  }
  .verdict .bad {
    fill: var(--red);
  }
  .verdict--bad .vb {
    fill: var(--amber);
  }

  .verdict {
    opacity: 0;
    animation: fade 0.35s var(--ease) forwards;
    animation-delay: calc(3s + var(--i) * 0.22s);
    animation-play-state: var(--run, running);
  }

  .drift-tag {
    opacity: 0;
    animation: fade 0.5s var(--ease) 2.8s forwards;
    animation-play-state: var(--run, running);
  }
  .drift-tag line {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 4 4;
  }
  .drift-tag rect {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .drift-tag text {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    fill: var(--field);
    letter-spacing: 0.08em;
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  figcaption {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    max-width: 60ch;
    line-height: 1.75;
  }

  /* --- portrait variant --------------------------------------------------- */
  .drift__portrait {
    display: none;
    background: var(--field);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--drop);
    padding: 1.1rem 0.9rem 1.25rem;
  }
  .drift__portrait svg {
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }

  .m-head {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    fill: var(--ink);
  }
  .m-sub {
    font-size: 9.5px;
    fill: var(--ink-faint);
  }
  .m-code-label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    fill: var(--ink);
    opacity: 0;
    animation: fade 0.4s var(--ease) 2.5s forwards;
    animation-play-state: var(--run, running);
  }

  .m-agreed {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-dasharray: 8 6;
    stroke-dashoffset: 400;
    animation: draw-agreed 0.9s var(--ease-io) forwards;
    animation-play-state: var(--run, running);
  }
  .m-code {
    stroke: var(--red);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: draw-m-code 2.2s var(--ease-io) 0.75s forwards;
    animation-play-state: var(--run, running);
  }
  @keyframes draw-m-code {
    to {
      stroke-dashoffset: 0;
    }
  }
  .m-gap {
    opacity: 0;
    animation: fade 0.8s var(--ease) 2.3s forwards;
    animation-play-state: var(--run, running);
  }
  .m-commit {
    fill: var(--amber);
    stroke: var(--ink);
    stroke-width: 2;
    opacity: 0;
    animation: fade 0.25s var(--ease) forwards;
    animation-delay: calc(1.1s + var(--i) * 0.42s);
    animation-play-state: var(--run, running);
  }
  .m-head-sq {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 2;
    opacity: 0;
    animation: fade 0.3s var(--ease) 2.7s forwards;
    animation-play-state: var(--run, running);
  }
  .m-tick line {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .m-tick text {
    font-size: 10px;
    fill: var(--ink-faint);
  }
  .m-drift {
    opacity: 0;
    animation: fade 0.5s var(--ease) 2.8s forwards;
    animation-play-state: var(--run, running);
  }
  .m-drift rect {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .m-drift text {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    fill: var(--field);
    letter-spacing: 0.08em;
  }

  .m-verdicts {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .m-verdicts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--win);
    border: var(--edge) solid var(--ink);
    border-radius: var(--radius-sm);
    box-shadow: var(--drop-sm);
    padding: 0.5rem 0.7rem;
    font-size: 0.82rem;
    opacity: 0;
    animation: fade 0.35s var(--ease) forwards;
    animation-play-state: var(--run, running);
  }
  .m-verdicts li:nth-child(1) { animation-delay: 3s; }
  .m-verdicts li:nth-child(2) { animation-delay: 3.2s; }
  .m-verdicts li:nth-child(3) { animation-delay: 3.4s; }
  .m-verdicts .is-bad {
    background: var(--amber);
  }
  .m-verdicts b {
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .m-verdicts .ok {
    color: var(--green);
  }
  .m-verdicts .bad {
    color: var(--red);
  }

  @media (max-width: 860px) {
    .drift__scroll {
      display: none;
    }
    .drift__portrait {
      display: block;
    }
  }
</style>
